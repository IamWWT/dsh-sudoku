{
  "name": "dsh-sudoku",
  "version": "0.1.4",
  "description": "DSH 数独：右侧栏标签里的经典 9×9 数独。三难度（入门 40/进阶 30/专家 22 提示，唯一解）/ 铅笔笔记 / 撤销 / 提示 / 冲突高亮 / 首填安全；纯客户端零依赖，成绩存 localStorage。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sudoku",
    "game"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "scripts/",
    "tsconfig.json",
    "tsconfig.client.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "docs/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:notypecheck": "node scripts/build.mjs --no-typecheck",
    "check": "node scripts/build.mjs && node test/engine-test.mjs && node test/smoke-test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node test/engine-test.mjs && node test/smoke-test.mjs",
    "pack": "npm pack",
    "verify:installed": "node scripts/verify-installed.mjs",
    "install:dev": "bash scripts/install-to-dsh.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
